###############################################################################
# ColSaaS ERP — Configuración para Docker Compose
# Copiar este archivo a .env cuando se use Docker: cp .env.docker .env
###############################################################################

APP_NAME="NextPOS-SaaS ERP"
APP_ENV=local
APP_KEY=base64:Zc5RuZlH3W0GOw+F+XXJ6yIW9JVhjriFFcrGpkq8bbs=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── Base de datos (servicio postgres del docker-compose) ─────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nextpossaas_db
DB_USERNAME=postgres
DB_PASSWORD=root

# ─── Sesión / Caché / Colas con Redis ─────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# ─── Redis (servicio redis del docker-compose) ────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Email (Mailpit del docker-compose) ───────────────────────────────────
# Ver emails en http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@colsaas.co"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Almacenamiento S3 ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── Multi-tenancy ────────────────────────────────────────────────────────
TENANCY_DB_CONNECTION=pgsql

# ─── Proveedor DIAN ───────────────────────────────────────────────────────
DIAN_PROVIDER=nextpyme
DIAN_ENVIRONMENT=habilitacion
DIAN_API_URL=
DIAN_API_KEY=
DIAN_SOFTWARE_ID=
DIAN_SOFTWARE_PIN=

# ─── Vite ─────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
