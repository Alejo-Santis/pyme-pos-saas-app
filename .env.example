APP_NAME="PymePOS SaaS ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── Base de datos ────────────────────────────────────────────────────────
# Con Laragon: DB_HOST=127.0.0.1
# Con Docker:  DB_HOST=postgres
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pymepossaas_db
DB_USERNAME=postgres
DB_PASSWORD=

# ─── Sesión / Caché / Colas ───────────────────────────────────────────────
# Laragon sin Redis: SESSION_DRIVER=database, CACHE_STORE=database, QUEUE_CONNECTION=database
# Docker con Redis:  SESSION_DRIVER=redis,    CACHE_STORE=redis,    QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ─── Redis ────────────────────────────────────────────────────────────────
# Con Docker: REDIS_HOST=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Email ────────────────────────────────────────────────────────────────
# Desarrollo: MAIL_MAILER=log (o smtp apuntando a Mailpit localhost:1025)
# Producción: MAIL_MAILER=mailgun o ses
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@colsaas.co"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Super-admin landlord ────────────────────────────────────────────────
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@pymepossaas.test
SUPER_ADMIN_PASSWORD=

# ─── Almacenamiento (Cloudflare R2 en producción) ─────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── Multi-tenancy ────────────────────────────────────────────────────────
TENANCY_DB_CONNECTION=pgsql

# ─── Proveedor DIAN ───────────────────────────────────────────────────────
DIAN_PROVIDER=nextpyme
DIAN_ENVIRONMENT=habilitacion
DIAN_API_URL=
DIAN_API_KEY=
DIAN_SOFTWARE_ID=
DIAN_SOFTWARE_PIN=

# ─── Vite ─────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
